---
import { t, type Locale } from '../data/i18n';
import { profile } from '../data/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-200 dark:border-ink-800">
  <div class="shell py-6">
    <p class="font-mono text-[12px] text-ink-400 dark:text-ink-500">
      © {year} {profile.name}. {strings.footer.rights}
    </p>
  </div>
</footer>
