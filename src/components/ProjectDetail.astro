---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { t, type Locale } from '../data/i18n';
import { projects, type Project, type ProjectCategory } from '../data/projects';

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const strings = t(locale);
const content = project.content[locale];

/** Prefix rute: '' untuk ID, '/en' untuk EN. */
const prefix = locale === 'id' ? '' : '/en';

const categoryLabels: Record<ProjectCategory, string> = {
  web: strings.filters.web,
  network: strings.filters.network,
  docs: strings.filters.docs,
};

const index = projects.findIndex((item) => item.slug === project.slug);
const next = projects[(index + 1) % projects.length];

const sections = [
  { label: strings.labels.problem, body: content.problem },
  { label: strings.labels.approach, body: content.approach },
  { label: strings.labels.result, body: content.result },
];
---

<div class="min-h-screen">
  <Nav locale={locale} path={`projects/${project.slug}`} />

  <main id="main" class="pt-8 pb-20">
    <div class="shell">
      <a
        href={locale === 'id' ? '/' : '/en/'}
        class="inline-flex items-center gap-1.5 text-sm text-ink-500 transition-colors hover:text-brand-700 dark:text-ink-400 dark:hover:text-brand-300"
      >
        <Icon name="arrow-left" class="h-4 w-4" />
        {strings.labels.backToHome}
      </a>

      <header class="mt-8 max-w-3xl" data-reveal>
        <p class="eyebrow">
          {categoryLabels[project.category]} · {project.year}
        </p>
        <h1
          class="mt-4 text-[2.25rem] leading-[1.08] font-semibold tracking-[-0.03em] text-ink-950 sm:text-[3rem] dark:text-ink-50"
        >
          {content.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-ink-600 dark:text-ink-400">
          {content.subtitle}
        </p>
      </header>

      <div
        class="mt-10 overflow-hidden rounded-3xl border border-ink-200 dark:border-ink-800"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        <img
          src={project.gallery[0].src}
          alt={project.gallery[0].alt[locale]}
          width="1200"
          height="750"
          class="aspect-[16/9] w-full object-cover dark:brightness-90 dark:saturate-[0.85]"
        />
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-8">
          <div class="space-y-10">
            {
              sections.map((section, i) => (
                <section data-reveal style={`--reveal-delay: ${i * 70}ms`}>
                  <h2 class="flex items-center gap-3 font-mono text-[12px] tracking-widest text-brand-600 uppercase dark:text-brand-400">
                    <span class="h-px w-6 bg-current opacity-50" />
                    {section.label}
                  </h2>
                  <p class="mt-4 text-[16.5px] leading-[1.75] text-ink-600 dark:text-ink-400">
                    {section.body}
                  </p>
                </section>
              ))
            }
          </div>

          {
            project.gallery.length > 1 && (
              <section class="mt-12" data-reveal>
                <h2 class="flex items-center gap-3 font-mono text-[12px] tracking-widest text-brand-600 uppercase dark:text-brand-400">
                  <span class="h-px w-6 bg-current opacity-50" />
                  {strings.labels.gallery}
                </h2>
                <div class="mt-5 grid gap-4 sm:grid-cols-2">
                  {project.gallery.map((image) => (
                    <a
                      href={image.src}
                      target="_blank"
                      rel="noreferrer noopener"
                      class="group overflow-hidden rounded-2xl border border-ink-200 dark:border-ink-800"
                    >
                      <img
                        src={image.src}
                        alt={image.alt[locale]}
                        width="1200"
                        height="750"
                        loading="lazy"
                        decoding="async"
                        class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] dark:brightness-90 dark:saturate-[0.85]"
                      />
                    </a>
                  ))}
                </div>
              </section>
            )
          }
        </div>

        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-24 lg:space-y-5">
            <div class="card p-5" data-reveal>
              <h2 class="font-mono text-[11px] tracking-widest text-ink-400 uppercase dark:text-ink-500">
                {strings.labels.techStack}
              </h2>
              <ul class="mt-3 flex flex-wrap gap-2">
                {
                  project.tech.map((item) => (
                    <li class="chip !px-2.5 !py-1 !text-[12.5px]">{item}</li>
                  ))
                }
              </ul>
            </div>

            <div class="card p-5" data-reveal style="--reveal-delay: 70ms">
              <h2 class="font-mono text-[11px] tracking-widest text-ink-400 uppercase dark:text-ink-500">
                {strings.labels.links}
              </h2>
              {
                project.links?.repo || project.links?.demo ? (
                  <div class="mt-3 flex flex-col gap-2">
                    {project.links.repo && (
                      <a
                        href={project.links.repo}
                        target="_blank"
                        rel="noreferrer noopener"
                        class="btn btn-ghost w-full justify-start"
                      >
                        <Icon name="github" class="h-4 w-4" />
                        {strings.labels.repository}
                      </a>
                    )}
                    {project.links.demo && (
                      <a
                        href={project.links.demo}
                        target="_blank"
                        rel="noreferrer noopener"
                        class="btn btn-ghost w-full justify-start"
                      >
                        <Icon name="external" class="h-4 w-4" />
                        {strings.labels.liveDemo}
                      </a>
                    )}
                  </div>
                ) : (
                  <p class="mt-3 text-sm leading-relaxed text-ink-500 dark:text-ink-400">
                    {strings.labels.noLink}
                  </p>
                )
              }
            </div>

            <div class="card p-5" data-reveal style="--reveal-delay: 140ms">
              <h2 class="font-mono text-[11px] tracking-widest text-ink-400 uppercase dark:text-ink-500">
                {strings.labels.category}
              </h2>
              <p class="mt-3 text-sm text-ink-700 dark:text-ink-300">
                {categoryLabels[project.category]}
              </p>
              <h2 class="mt-5 font-mono text-[11px] tracking-widest text-ink-400 uppercase dark:text-ink-500">
                {strings.labels.year}
              </h2>
              <p class="mt-3 text-sm text-ink-700 dark:text-ink-300">{project.year}</p>
            </div>
          </div>
        </aside>
      </div>

      <div class="mt-16 border-t border-ink-200 pt-10 dark:border-ink-800" data-reveal>
        <p class="eyebrow">{strings.labels.nextProject}</p>
        <a
          href={`${prefix}/projects/${next.slug}`}
          class="group mt-4 flex items-baseline gap-3"
        >
          <span
            class="text-2xl font-semibold tracking-tight text-ink-950 transition-colors group-hover:text-brand-700 sm:text-3xl dark:text-ink-50 dark:group-hover:text-brand-300"
          >
            {next.content[locale].title}
          </span>
          <Icon
            name="arrow-right"
            class="h-6 w-6 shrink-0 text-ink-400 transition-transform duration-300 group-hover:translate-x-1.5 group-hover:text-brand-600"
          />
        </a>
        <p class="mt-2 text-[15px] text-ink-500 dark:text-ink-400">
          {next.content[locale].subtitle}
        </p>
      </div>
    </div>
  </main>

  <Footer locale={locale} />
</div>
