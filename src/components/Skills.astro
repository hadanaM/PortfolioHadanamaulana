---
import { t, type Locale } from '../data/i18n';
import { skillGroups } from '../data/skills';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

<section id="skills" class="scroll-mt-24 py-20 sm:py-28">
  <div class="shell">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">{strings.sections.skillsEyebrow}</p>
        <h2
          class="mt-4 text-[2rem] leading-[1.12] font-semibold tracking-[-0.025em] text-ink-950 sm:text-[2.6rem] dark:text-ink-50"
        >
          {strings.sections.skillsHeading}
        </h2>
      </div>
      <p
        class="text-[16px] leading-relaxed text-ink-600 lg:col-span-5 lg:text-right dark:text-ink-400"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        {strings.sections.skillsIntro}
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        skillGroups.map((group, index) => (
          <div
            class:list={[
              'card card-hover flex flex-col p-6',
              index === 0 && 'sm:col-span-2 lg:col-span-1',
            ]}
            data-reveal
            style={`--reveal-delay: ${(index % 3) * 70}ms`}
          >
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-base font-semibold tracking-tight text-ink-950 dark:text-ink-50">
                {group.label[locale]}
              </h3>
              <span class="font-mono text-[11px] text-ink-400 dark:text-ink-500">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>

            <p class="mt-1.5 text-[13.5px] leading-snug text-ink-500 dark:text-ink-400">
              {group.note[locale]}
            </p>

            <ul class="mt-5 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="chip transition-colors hover:border-brand-300 hover:text-brand-700 dark:hover:border-brand-700 dark:hover:text-brand-300">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
