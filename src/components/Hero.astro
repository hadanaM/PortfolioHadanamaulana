---
import Icon from './Icon.astro';
import { t, type Locale } from '../data/i18n';
import { profile } from '../data/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const content = profile.summary[locale];

const quickFacts = [
  {
    label: locale === 'id' ? 'Pendidikan' : 'Education',
    value:
      locale === 'id'
        ? 'Teknik Informatika, UNISSULA Semarang'
        : 'Informatics Engineering, UNISSULA Semarang',
  },
  {
    label: locale === 'id' ? 'Fokus' : 'Focus',
    value:
      locale === 'id' ? 'IT Support & Network Engineering' : 'IT Support & Network Engineering',
  },
  {
    label: locale === 'id' ? 'Status' : 'Status',
    value: strings.hero.available,
  },
];
---

<section class="relative overflow-hidden pt-14 pb-20 sm:pt-20 sm:pb-28">
  <!-- Latar: lingkaran biru samar supaya tidak polos -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[36rem] bg-[radial-gradient(60%_60%_at_18%_0%,rgb(198_218_245_/_0.85),transparent_70%)] dark:bg-[radial-gradient(60%_60%_at_18%_0%,rgb(35_62_103_/_0.6),transparent_70%)]"
  >
  </div>

  <div class="shell">
    <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-10">
      <!-- Kolom kiri: judul & aksi -->
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>
          {strings.hero.eyebrow}
        </p>

        <h1
          class="mt-5 text-[2.5rem] leading-[1.06] font-semibold tracking-[-0.03em] text-ink-950 sm:text-[3.4rem] dark:text-ink-50"
          data-reveal
          style="--reveal-delay: 60ms"
        >
          {profile.headline[locale]}
          <span class="mt-2 block text-brand-600 dark:text-brand-400">
            {profile.specialty[locale]}
          </span>
        </h1>

        <p
          class="mt-6 max-w-xl text-[17px] leading-relaxed text-ink-600 dark:text-ink-400"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          {strings.hero.summaryLead}
        </p>

        <div
          class="mt-8 flex flex-wrap items-center gap-3"
          data-reveal
          style="--reveal-delay: 180ms"
        >
          <a
            href={profile.cv.href}
            download={profile.cv.filename}
            class="btn btn-primary"
          >
            <Icon name="download" class="h-4 w-4" />
            {strings.hero.downloadCv}
          </a>
          <a href="#projects" class="btn btn-ghost">
            {strings.hero.viewProjects}
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>

        <!-- Sosial -->
        <ul
          class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3"
          data-reveal
          style="--reveal-delay: 240ms"
        >
          {
            profile.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                  rel={social.href.startsWith('http') ? 'noreferrer noopener' : undefined}
                  class="group inline-flex items-center gap-2 text-sm text-ink-600 transition-colors hover:text-brand-700 dark:text-ink-400 dark:hover:text-brand-300"
                >
                  <Icon
                    name={social.key === 'email' ? 'mail' : social.key === 'linkedin' ? 'linkedin' : 'github'}
                    class="h-4 w-4"
                  />
                  <span class="border-b border-transparent transition-colors group-hover:border-brand-400">
                    {social.display}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Kolom kanan: kartu ringkas -->
      <div class="lg:col-span-5" data-reveal style="--reveal-delay: 200ms">
        <div class="card card-hover p-6 sm:p-7">
          <div class="flex items-center gap-4">
            <!-- Ganti dengan foto asli: <img src="/images/profile.jpg" alt="..." class="h-16 w-16 rounded-2xl object-cover" /> -->
            <div
              class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-brand-500 to-brand-800 font-mono text-lg font-bold text-white"
              aria-hidden="true"
            >
              {profile.initials}
            </div>
            <div class="min-w-0">
              <p class="truncate text-base font-semibold tracking-tight text-ink-950 dark:text-ink-50">
                {profile.name}
              </p>
              <p class="mt-0.5 flex items-center gap-1.5 text-sm text-ink-500 dark:text-ink-400">
                <span class="relative flex h-2 w-2">
                  <span
                    class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
                  ></span>
                  <span
                    class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
                </span>
                {strings.hero.available}
              </p>
            </div>
          </div>

          <dl class="mt-6 space-y-4 border-t border-ink-100 pt-5 dark:border-ink-800">
            {
              quickFacts.map((fact) => (
                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
                  <dt class="font-mono text-[11px] tracking-wider text-ink-400 uppercase dark:text-ink-500 sm:w-24 sm:shrink-0">
                    {fact.label}
                  </dt>
                  <dd class="text-sm leading-snug text-ink-700 dark:text-ink-300">
                    {fact.value}
                  </dd>
                </div>
              ))
            }
          </dl>

          <div class="mt-6 flex items-center gap-3 border-t border-ink-100 pt-5 dark:border-ink-800">
            <Icon name="mail" class="h-4 w-4 text-ink-400" />
            <a
              href={profile.socials[0].href}
              class="truncate text-sm text-ink-600 transition-colors hover:text-brand-700 dark:text-ink-400 dark:hover:text-brand-300"
            >
              {profile.socials[0].label}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Ringkasan penuh -->
    <div class="mt-16 sm:mt-24" data-reveal>
      <div class="rule mb-8"></div>
      <div class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow">
            {locale === 'id' ? 'Tentang saya' : 'About me'}
          </p>
          <p
            class="mt-4 text-2xl leading-snug font-semibold tracking-tight text-ink-950 dark:text-ink-50"
          >
            {
              locale === 'id'
                ? 'Satu halaman, tiga sudut pandang.'
                : 'One page, three perspectives.'
            }
          </p>
        </div>
        <div class="lg:col-span-8">
          <p
            class="text-[16.5px] leading-[1.75] text-ink-600 dark:text-ink-400"
          >
            {content}
          </p>
          <div class="mt-7 flex flex-wrap gap-2">
            {
              (locale === 'id'
                ? ['IT Support', 'Network Engineering', 'Troubleshooting', 'Dokumentasi Teknis', 'Robotika']
                : [
                    'IT Support',
                    'Network Engineering',
                    'Troubleshooting',
                    'Technical Documentation',
                    'Robotics',
                  ]
              ).map((tag) => <span class="chip">{tag}</span>)
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
