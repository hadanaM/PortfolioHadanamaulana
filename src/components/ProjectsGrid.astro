---
import Icon from './Icon.astro';
import { t, type Locale } from '../data/i18n';
import { projects, categoryOrder, type ProjectCategory } from '../data/projects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

const categoryLabels: Record<ProjectCategory, string> = {
  web: strings.filters.web,
  network: strings.filters.network,
  docs: strings.filters.docs,
};

const tabs = [
  { key: 'all' as const, label: strings.filters.all, count: projects.length },
  ...categoryOrder.map((category) => ({
    key: category,
    label: categoryLabels[category],
    count: projects.filter((project) => project.category === category).length,
  })),
];
---

<section id="projects" class="scroll-mt-24 py-20 sm:py-28">
  <div class="shell">
    <!-- Header -->
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">{strings.sections.projectsEyebrow}</p>
        <h2
          class="mt-4 text-[2rem] leading-[1.12] font-semibold tracking-[-0.025em] text-ink-950 sm:text-[2.6rem] dark:text-ink-50"
        >
          {strings.sections.projectsHeading}
        </h2>
      </div>
      <p
        class="text-[16px] leading-relaxed text-ink-600 lg:col-span-5 lg:text-right dark:text-ink-400"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        {strings.sections.projectsIntro}
      </p>
    </div>

    <!-- Filter -->
    <div
      class="mt-9 flex flex-wrap gap-2"
      role="tablist"
      aria-label={strings.nav.projects}
      data-reveal
      style="--reveal-delay: 120ms"
    >
      {
        tabs.map((tab) => (
          <button
            type="button"
            role="tab"
            data-filter={tab.key}
            aria-selected={tab.key === 'all' ? 'true' : 'false'}
            class="filter-tab group inline-flex items-center gap-1.5 rounded-full border px-4 py-2 text-sm font-medium transition-all duration-200 aria-selected:border-brand-600 aria-selected:bg-brand-600 aria-selected:text-white border-ink-200 text-ink-600 hover:border-brand-300 hover:text-brand-700 dark:border-ink-700 dark:text-ink-400 dark:hover:border-brand-700 dark:hover:text-brand-300"
          >
            {tab.label}
            <span class="font-mono text-[11px] opacity-60">{tab.count}</span>
          </button>
        ))
      }
    </div>

    <!-- Grid masonry: kolom CSS, jadi tinggi kartu bebas → tidak kaku -->
    <div
      class="mt-10 gap-6 sm:columns-2 lg:columns-3"
      data-project-grid
    >
      {
        projects.map((project, index) => {
          const content = project.content[locale];
          const cover = project.gallery[0];

          return (
            <article
              data-category={project.category}
              class="mb-6 break-inside-avoid"
              data-reveal
              style={`--reveal-delay: ${(index % 3) * 70}ms`}
            >
              <a
                href={`${locale === 'id' ? '' : '/en/'}projects/${project.slug}`}
                class="card card-hover group block overflow-hidden"
              >
                <!-- Gambar -->
                <div class="relative overflow-hidden">
                  <img
                    src={cover.src}
                    alt={cover.alt[locale]}
                    width="1200"
                    height="750"
                    loading="lazy"
                    decoding="async"
                    class="aspect-[16/10] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] dark:brightness-90 dark:saturate-[0.85]"
                  />
                  <div class="absolute top-3 left-3 flex gap-2">
                    <span class="rounded-full bg-ink-950/75 px-3 py-1 font-mono text-[11px] tracking-wider text-white uppercase backdrop-blur-sm">
                      {categoryLabels[project.category]}
                    </span>
                    {project.featured && (
                      <span class="rounded-full bg-brand-600 px-3 py-1 font-mono text-[11px] tracking-wider text-white uppercase backdrop-blur-sm">
                        {strings.labels.featured}
                      </span>
                    )}
                  </div>
                </div>

                <!-- Isi -->
                <div class="p-5 sm:p-6">
                  <div class="flex items-baseline justify-between gap-3">
                    <h3 class="text-lg leading-snug font-semibold tracking-tight text-ink-950 dark:text-ink-50">
                      {content.title}
                    </h3>
                    <span class="shrink-0 font-mono text-xs text-ink-400 dark:text-ink-500">
                      {project.year}
                    </span>
                  </div>

                  <p class="mt-2 text-[15px] leading-relaxed text-ink-600 dark:text-ink-400">
                    {content.summary}
                  </p>

                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {project.tech.slice(0, 4).map((item) => (
                      <span class="chip !px-2.5 !py-1 !text-[12px]">{item}</span>
                    ))}
                  </div>

                  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-brand-700 transition-colors group-hover:text-brand-800 dark:text-brand-300 dark:group-hover:text-brand-200">
                    {strings.labels.viewProject}
                    <Icon
                      name="arrow-right"
                      class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                    />
                  </span>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>

    <p
      data-empty-message
      class="mt-10 hidden rounded-2xl border border-dashed border-ink-300 p-10 text-center text-sm text-ink-500 dark:border-ink-700 dark:text-ink-400"
    >
      {locale === 'id' ? 'Belum ada proyek pada kategori ini.' : 'No projects in this category yet.'}
    </p>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  const emptyMessage = document.querySelector<HTMLElement>('[data-empty-message]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter ?? 'all';

      tabs.forEach((other) => {
        other.setAttribute('aria-selected', String(other === tab));
      });

      let visible = 0;
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });

      emptyMessage?.classList.toggle('hidden', visible !== 0);
    });
  });
</script>
