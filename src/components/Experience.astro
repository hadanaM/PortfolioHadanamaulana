---
import Icon from './Icon.astro';
import { t, type Locale } from '../data/i18n';
import { sortedExperiences } from '../data/experience';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

<section id="experience" class="scroll-mt-24 py-20 sm:py-28">
  <div class="shell">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">{strings.sections.experienceEyebrow}</p>
        <h2
          class="mt-4 text-[2rem] leading-[1.12] font-semibold tracking-[-0.025em] text-ink-950 sm:text-[2.6rem] dark:text-ink-50"
        >
          {strings.sections.experienceHeading}
        </h2>
      </div>
      <p
        class="text-[16px] leading-relaxed text-ink-600 lg:col-span-5 lg:text-right dark:text-ink-400"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        {strings.sections.experienceIntro}
      </p>
    </div>

    <ol
      class="relative mt-12 space-y-6 border-l border-ink-200 pl-8 sm:pl-10 dark:border-ink-800"
    >
      {
        sortedExperiences.map((item, index) => {
          const content = item.content[locale];

          return (
            <li class="relative" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
              <!-- Titik pada garis timeline -->
              <span
                aria-hidden="true"
                class="absolute top-8 -left-[calc(2rem+0.3125rem)] h-2.5 w-2.5 rounded-full bg-brand-600 ring-4 ring-ink-50 sm:-left-[calc(2.5rem+0.3125rem)] dark:ring-ink-950"
              >
              </span>

              <article class="card card-hover p-5 sm:p-6">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h3 class="text-lg leading-snug font-semibold tracking-tight text-ink-950 dark:text-ink-50">
                      {content.role}
                    </h3>
                    <p class="mt-1 flex items-center gap-1.5 text-[15px] text-brand-700 dark:text-brand-300">
                      <Icon name="arrow-up-right" class="h-4 w-4 opacity-70" />
                      {content.org}
                    </p>
                  </div>

                  <span
                    class="shrink-0 rounded-full bg-brand-50 px-3 py-1.5 font-mono text-[11px] tracking-wide whitespace-nowrap text-brand-700 dark:bg-brand-950/70 dark:text-brand-300"
                  >
                    {item.period[locale]}
                  </span>
                </div>

                <p class="mt-4 text-[15.5px] leading-relaxed text-ink-600 dark:text-ink-400">
                  {content.summary}
                </p>

                <ul class="mt-4 space-y-2">
                  {
                    content.highlights.map((highlight) => (
                      <li class="flex gap-2.5 text-[15px] leading-relaxed text-ink-600 dark:text-ink-400">
                        <Icon
                          name="check"
                          class="mt-1 h-4 w-4 shrink-0 text-brand-500 dark:text-brand-400"
                        />
                        <span>{highlight}</span>
                      </li>
                    ))
                  }
                </ul>

                <!-- Foto & sertifikat (placeholder sampai asli dipasang) -->
                <div class="mt-5 flex flex-wrap gap-3 border-t border-ink-100 pt-5 dark:border-ink-800">
                  <a
                    href={item.photo}
                    target="_blank"
                    rel="noreferrer noopener"
                    class="group flex items-center gap-3 rounded-xl border border-ink-200 p-2 pr-4 transition-colors hover:border-brand-400 dark:border-ink-700 dark:hover:border-brand-700"
                  >
                    <img
                      src={item.photo}
                      alt={item.photoAlt[locale]}
                      width="900"
                      height="675"
                      loading="lazy"
                      decoding="async"
                      class="h-12 w-16 rounded-lg object-cover dark:brightness-90"
                    />
                    <span class="text-[13px] leading-tight font-medium text-ink-700 dark:text-ink-300">
                      {locale === 'id' ? 'Foto kegiatan' : 'Activity photo'}
                      <span class="mt-0.5 block font-mono text-[11px] text-ink-400 dark:text-ink-500">
                        {locale === 'id' ? 'lihat' : 'view'}
                      </span>
                    </span>
                  </a>

                  {item.certificate && (
                    <a
                      href={item.certificate}
                      target="_blank"
                      rel="noreferrer noopener"
                      class="group flex items-center gap-3 rounded-xl border border-ink-200 p-2 pr-4 transition-colors hover:border-brand-400 dark:border-ink-700 dark:hover:border-brand-700"
                    >
                      <img
                        src={item.certificate}
                        alt={item.certificateAlt?.[locale] ?? ''}
                        width="1100"
                        height="780"
                        loading="lazy"
                        decoding="async"
                        class="h-12 w-16 rounded-lg object-cover dark:brightness-90"
                      />
                      <span class="text-[13px] leading-tight font-medium text-ink-700 dark:text-ink-300">
                        {locale === 'id' ? 'Sertifikat' : 'Certificate'}
                        <span class="mt-0.5 block font-mono text-[11px] text-ink-400 dark:text-ink-500">
                          {locale === 'id' ? 'lihat' : 'view'}
                        </span>
                      </span>
                    </a>
                  )}
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
